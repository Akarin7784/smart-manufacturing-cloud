<!-- 覆盖率汇总模块：不含代码，仅依赖全部业务模块，用 report-aggregate 生成跨模块覆盖率报告，
     使 cloud-common 等公共模块被其他服务测试执行到的代码也能被统计。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.smartmanufacturing</groupId><artifactId>manufacturing-cloud</artifactId><version>1.0.0-SNAPSHOT</version></parent>
  <artifactId>coverage-report</artifactId><packaging>pom</packaging>
  <name>coverage-report</name>
  <!-- 依赖顺序决定 reactor 构建顺序：本模块必须最后构建，才能读取各模块的 jacoco.exec。 -->
  <dependencies>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>cloud-common</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>cloud-api</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>cloud-security</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>auth-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>cloud-gateway</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>device-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>workorder-service</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>com.smartmanufacturing</groupId><artifactId>masterdata-service</artifactId><version>${project.version}</version></dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>org.jacoco</groupId><artifactId>jacoco-maven-plugin</artifactId>
      <executions>
        <!-- 汇总报告输出到 coverage-report/target/site/jacoco-aggregate，CI 上传为构建产物。 -->
        <execution><id>report-aggregate</id><phase>verify</phase><goals><goal>report-aggregate</goal></goals></execution>
      </executions>
    </plugin>
  </plugins></build>
</project>
