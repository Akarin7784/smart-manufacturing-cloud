# 本地演示环境变量模板：只提交本模板，真实值写入被 Git 忽略的 .env。
# 留空的密钥由 scripts/init-env.sh（或 init-env.ps1，make demo 会自动调用）随机生成；已有 .env 中的值不会被覆盖。

# 开发环境首个管理员 admin 的密码，至少十二个字符；仅在认证库没有用户时生效。
AUTH_BOOTSTRAP_PASSWORD=
# 演示账号 qc01（质检员 QUALITY_INSPECTOR）与 op01（操作员 OPERATOR）的密码；留空由 init-env 生成，认证服务启动时按用户名幂等创建。
AUTH_DEMO_QC01_PASSWORD=
AUTH_DEMO_OP01_PASSWORD=
# 外部令牌签发者与受众需由网关和所有业务服务统一配置。
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=manufacturing-api

# 服务间调用（OAuth2 client_credentials）：工单服务的客户端密钥明文，只注入 workorder-service。
WORKORDER_CLIENT_SECRET=
# 上面密钥的 BCrypt 散列，只注入 auth-service；由 init-env 根据明文生成，二者必须配对，切勿手填明文。
WORKORDER_CLIENT_SECRET_HASH=

# MySQL root 密码，仅供数据库初始化容器使用，业务服务不使用 root。
MYSQL_ROOT_PASSWORD=
# 设备、工单、认证服务专用数据库账号的共同密码；初始化容器会同步到已有账号。
MYSQL_APP_PASSWORD=

# Nacos 鉴权：令牌签名密钥必须是 Base64 编码且解码后不少于 32 字节。
NACOS_AUTH_TOKEN=
# Nacos 集群节点间身份标识，开启鉴权后必须配置。
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=
# Nacos 管理员账号；首次启动时由 nacos-config-init 初始化密码，业务服务也用它读取配置和注册。
NACOS_USERNAME=nacos
NACOS_PASSWORD=

# Flyway：是否把“已有表但没有迁移历史”的旧库登记为版本 1（不执行 V1）。默认 false，旧库启动会直接失败，
# 推荐执行 make demo-reset 重建；只有确认旧库结构与各服务 V1__init.sql 完全一致时才设为 true。
FLYWAY_BASELINE_ON_MIGRATE=false

# RocketMQ（演示环境无 ACL，不需要密钥）；以下均可留空使用默认值。
# 镜像标签，默认 5.5.0。
ROCKETMQ_IMAGE_TAG=
# NameServer / Broker 的 JVM 参数；Broker 堆上限默认 512M，共享机器上不要调大。
ROCKETMQ_NAMESRV_JAVA_OPT=
ROCKETMQ_BROKER_JAVA_OPT=

# 可选监控（docker compose --profile monitoring）：Grafana 管理员账号和密码，留空由 init-env 随机生成。
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
